# OSINT App Configuration
# Copy this file to .env and fill in your values

# Twitter API Credentials
# Get these from https://developer.twitter.com/
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Reddit API Credentials
# Get these from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=OSINT-Monitor/2.0

# GitHub API Token (optional - increases rate limits)
# Get from https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# News API Credentials
# Get your key from https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# Shodan API Key (optional)
# Get from https://account.shodan.io/
SHODAN_API_KEY=your_shodan_api_key_here

# YouTube Data API v3 Key (optional)
# Get from https://console.developers.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Telegram API Credentials (optional)
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# RSS Feeds (optional - comma-separated list of feed URLs)
# RSS_FEEDS=https://feeds.feedburner.com/example,https://example.com/feed.xml

# Database Configuration
DB_URL=sqlite:///osint_data.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_ENABLED=false

# Application Settings
APP_NAME=OSINT Monitoring Platform
VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Feature Flags
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_CACHING=false
ENABLE_WEB_SCRAPING=true

# Rate Limiting
RATE_LIMIT_DELAY=1.0
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# Agent Activity Log Settings
LOG_TO_DB=true
LOG_FILE=logs/agent_activity.jsonl
LOG_RING_BUFFER_SIZE=500
